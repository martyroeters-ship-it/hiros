# Local prototype only. Production for real patients must run in Turkey.
# Owner (migrations/seed + local demo API):
DATABASE_OWNER_URL=postgres://hiros:hiros@127.0.0.1:5432/hiros
# App role (RLS):
DATABASE_URL=postgres://hiros_app:hiros_app_login@127.0.0.1:5432/hiros
# Shared demo URL (Vercel/Neon): the hiros-client integration already
# injects POSTGRES_DATABASE_URL / POSTGRES_DATABASE_URL_UNPOOLED. No extra
# DATABASE_URL is required. SESSION_SECRET and DOCTOR_DEMO_PASSWORD have
# demo fallbacks if left unset.
# Signed session cookie for patient email login (demo):
SESSION_SECRET=change-me-for-the-istanbul-demo
# Demo physician login (seeded if demo.hekim@hiros.local has no password yet):
# Email: demo.hekim@hiros.local
DOCTOR_DEMO_PASSWORD=HirosDoctor1
# Google Sign-In (OAuth 2.0 Web client ID).
# Authorized JavaScript origins must include http://localhost:3000 and https://hiros.com.tr
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional. IBAN for the ₺750 demo transfer also lives in src/lib/bank-transfer.ts.
# NEXT_PUBLIC_PAY_IBAN=TR...
# NEXT_PUBLIC_PAY_ACCOUNT_NAME=Martijn Roeters
# NEXT_PUBLIC_PAY_BANK=
